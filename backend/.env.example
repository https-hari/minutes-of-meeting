# Copy to backend/.env  (never commit .env)

GROQ_API_KEY=
DATABASE_URL=postgresql://localhost/meetings

# Login (Supabase). 1 = no login, everything belongs to user "local" (local development only).
AUTH_DISABLED=1
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_JWT_SECRET=      # only for projects still on the legacy shared JWT secret

# Websites allowed to call the API (comma-separated, no trailing slash)
CORS_ORIGINS=http://localhost:3000

# Models: fastembed (ONNX, light, default) or torch (needs requirements-optional.txt)
MODEL_BACKEND=fastembed
# Transcription: groq (hosted Whisper, default) or local (needs requirements-optional.txt)
TRANSCRIBE_PROVIDER=groq

# Optional tuning
LLM_MODEL=openai/gpt-oss-120b
RETRIEVAL_MODE=hybrid_rerank
AGENT_MAX_STEPS=6
